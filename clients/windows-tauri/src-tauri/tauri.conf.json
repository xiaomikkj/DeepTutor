{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepTutor",
  "version": "0.1.0",
  "identifier": "com.deeptutor.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DeepTutor",
        "width": 1280,
        "height": 820,
        "minWidth": 420,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Education",
    "shortDescription": "DeepTutor Windows client",
    "longDescription": "Thin WebView2 shell around the DeepTutor agent-native learning companion.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
